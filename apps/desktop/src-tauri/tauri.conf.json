{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vyrra Desktop",
  "version": "0.1.0",
  "identifier": "com.runnerconcepts.vyrra.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vyrra Desktop",
        "width": 1180,
        "height": 780,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "indicator",
        "url": "index.html#/recording-indicator",
        "title": "Vyrra dictation",
        "width": 254,
        "height": 60,
        "resizable": false,
        "visible": false,
        "focus": false,
        "focusable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "publisher": "Runner Concepts",
    "category": "Productivity",
    "shortDescription": "A private, local-first voice workspace.",
    "longDescription": "Vyrra Desktop is a private, local-first workspace for intentional voice capture, transcription, notes, and user-controlled recall.",
    "copyright": "Copyright © 2026 Runner Concepts. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Vyrra Desktop",
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
